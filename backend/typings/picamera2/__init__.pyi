from typing import Any

import numpy as np

class CompletedRequest:
    def make_array(self, name: str) -> np.ndarray: ...
    def get_metadata(self) -> dict[str, Any]: ...
    def release(self) -> None: ...

class Picamera2:
    def __init__(self, camera_num: int = ...) -> None: ...
    def create_video_configuration(
        self,
        main: dict[str, Any] | None = ...,
        lores: dict[str, Any] | None = ...,
        raw: dict[str, Any] | None = ...,
        sensor: dict[str, Any] | None = ...,
        controls: dict[str, Any] | None = ...,
        queue: bool = ...,
        **kwargs: Any,
    ) -> dict[str, Any]: ...
    def configure(self, camera_config: dict[str, Any] | None = ...) -> None: ...
    def camera_configuration(self) -> dict[str, Any]: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def capture_request(self) -> CompletedRequest: ...
    def capture_array(self, name: str = ...) -> np.ndarray: ...
    def start_encoder(
        self,
        encoder: Any = ...,
        output: Any = ...,
        pts: Any = ...,
        quality: Any = ...,
        name: str | None = ...,
    ) -> None: ...
    def stop_encoder(self, encoders: Any = ...) -> None: ...
