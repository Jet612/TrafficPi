    {
      "name": "a corner dragged across the opposite side",
      "points": [[0.2, 0.2], [0.8, 0.2], [0.8, 0.8], [0.5, 0.1]],
      "simple": false,
      "area": null,
      "inside": []
    },
    {
      "name": "a corner resting on a non-neighbouring edge",
      "points": [[0.2, 0.2], [0.8, 0.2], [0.8, 0.8], [0.5, 0.2], [0.2, 0.8]],
      "simple": false,
      "area": null,
      "inside": []
    },
    {
      "name": "pinched at a point (figure of eight)",
      "points": [[0.2, 0.2], [0.5, 0.5], [0.8, 0.2], [0.8, 0.8], [0.5, 0.5], [0.2, 0.8]],
      "simple": false,
      "area": null,
      "inside": []
    },
    {
      "name": "a repeated point",
      "points": [[0.2, 0.2], [0.2, 0.2], [0.8, 0.2], [0.8, 0.8]],
      "simple": false,
      "area": null,
      "inside": []
