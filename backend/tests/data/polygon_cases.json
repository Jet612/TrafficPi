{
  "_about": "Shared by backend/tests/test_geometry.py and dashboard/src/lib/geometry.test.ts. The backend (core/geometry.py) and the zone editor (dashboard/src/lib/geometry.ts) must agree on what a usable outline is, so both are checked against these cases. 'simple' is Polygon.is_simple(); 'area' is Polygon.area(); each 'inside' entry is [x, y, expected] for Polygon.contains (the boundary counts as inside).",
  "cases": [
    {
      "name": "square",
      "points": [[0.2, 0.2], [0.8, 0.2], [0.8, 0.8], [0.2, 0.8]],
      "simple": true,
      "area": 0.36,
      "inside": [[0.5, 0.5, true], [0.1, 0.5, false], [0.2, 0.5, true], [0.2, 0.2, true], [0.9, 0.9, false]]
    },
    {
      "name": "square, the other way round",
      "points": [[0.2, 0.8], [0.8, 0.8], [0.8, 0.2], [0.2, 0.2]],
      "simple": true,
      "area": 0.36,
      "inside": [[0.5, 0.5, true], [0.1, 0.5, false]]
    },
    {
      "name": "L shape",
      "points": [[0, 0], [0.6, 0], [0.6, 0.3], [0.3, 0.3], [0.3, 0.6], [0, 0.6]],
      "simple": true,
      "area": 0.27,
      "inside": [[0.1, 0.5, true], [0.5, 0.1, true], [0.5, 0.5, false], [0.3, 0.3, true]]
    },
    {
      "name": "triangle",
      "points": [[0.1, 0.1], [0.9, 0.2], [0.5, 0.9]],
      "simple": true,
      "area": 0.3,
      "inside": [[0.5, 0.4, true], [0.1, 0.9, false]]
    },
    {
      "name": "a straight run split into two edges",
      "points": [[0.2, 0.2], [0.5, 0.2], [0.8, 0.2], [0.8, 0.8], [0.2, 0.8]],
      "simple": true,
      "area": 0.36,
      "inside": [[0.5, 0.5, true], [0.5, 0.2, true]]
    },
    {
      "name": "bow tie",
      "points": [[0.2, 0.2], [0.8, 0.8], [0.8, 0.2], [0.2, 0.8]],
      "simple": false,
      "area": 0,
      "inside": []
