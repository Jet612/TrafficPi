# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node / dashboard
node_modules/
.next/
dashboard/out/
dashboard/next-env.d.ts
*.tsbuildinfo
.pnpm-store/

# Runtime data and local artifacts: database, clips, snapshots, recordings, logs. The data
# directories are named in full: a bare `data/` would also hide backend/tests/data, whose test
# cases both the Python and the TypeScript tests read.
/data/
/backend/data/
*.log
hailort.log

# Local configuration and secrets
.env
.env.*

# The keys and databases the services make. They are normally under the data directory, ignored
# above; these catch a data directory that was pointed somewhere else.
secret.key
mail.key
*.pem
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# The maintainer's own files, kept in the checkout and not in the repository: the working notes
# (plan, task list, what is waiting on the owner), the instructions for AI assistants, and notes on
# presenting the project.
/plan.md
/todo.md
/owner.md
/CLAUDE.md
/docs/showcase.md
